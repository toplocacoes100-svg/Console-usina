rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa que abrir o app entra automaticamente como usuário
    // anônimo do Firebase (sem precisar criar login). Essas regras liberam
    // leitura/escrita apenas para quem passou por esse login anônimo —
    // ou seja, bloqueiam acesso direto de fora do app, mas não distinguem
    // "administrador" de "operador" (isso é controlado pela senha dentro
    // do próprio app, na aba Clientes/Produção).
    match /kv/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
